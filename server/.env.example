# Chenda Backend Environment Variables
# Copy this file to server/.env and update values.

# Runtime
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chenda
DB_USER=postgres
DB_PASSWORD=postgres

# Session (use 32+ chars in staging/production)
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE=86400000

# Xendit webhook verification
XENDIT_CALLBACK_TOKEN=replace-with-your-xendit-callback-token

# Xendit payment provider (Payment Requests V3)
ENABLE_PAYMENT_XENDIT=false
XENDIT_SECRET_KEY=xnd_development_your_secret_key
XENDIT_BASE_URL=https://api.xendit.co

# Payment feature flags
ENABLE_PAYMENT_GCASH=true
ENABLE_PAYMENT_COD=true
ENABLE_PAYMENT_RECONCILIATION_ENDPOINT=true
ENABLE_PAYMENT_ALERTS=true

# Delivery notification feature flags (provider-ready hooks)
ENABLE_EXTERNAL_DELIVERY_NOTIFICATIONS=false
ENABLE_DELIVERY_EMAIL=false
ENABLE_DELIVERY_SMS=false
ENABLE_DELIVERY_PUSH=false
DELIVERY_EMAIL_PROVIDER=provider_not_configured
DELIVERY_SMS_PROVIDER=provider_not_configured
DELIVERY_PUSH_PROVIDER=provider_not_configured

# Near-destination trigger threshold in meters (minimum 50)
DELIVERY_NEAR_DESTINATION_METERS=300

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880