# Workspace-level environment template
#
# Backend runtime variables should be placed in server/.env
# using server/.env.example as the source template.
#
# Frontend runtime variables should be placed in
# chenda-frontend/.env.local using chenda-frontend/.env.example.
#
# Keep this root .env for docker-compose or workspace-level overrides.

# Docker / shared essentials
DB_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001