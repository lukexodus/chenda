# Environment variables for Docker Compose.
# Used by all three services: db, backend, frontend.
# Edit values here, then run: docker compose up -d --build

# --- Database (PostgreSQL / PostGIS) ---
# Host port mapping: your machine:container. Use 5433 to avoid conflicts with local Postgres.
DB_HOST_PORT=5433
# Internal hostname — "db" is the service name in docker-compose.yml
DB_HOST=db
DB_PORT=5432
DB_NAME=chenda
DB_USER=postgres
DB_PASSWORD=postgres

# --- Backend ---
# SESSION_SECRET must be >= 32 characters.
SESSION_SECRET=9f2c8a7b5d3e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6

# --- URLs ---
# Browser-facing API URL (used by frontend in the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Internal container-to-container URL (do NOT change for local Docker)
INTERNAL_API_URL=http://backend:3001
# CORS origin allowed by the backend
FRONTEND_URL=http://localhost:3000
