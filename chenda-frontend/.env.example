# Chenda Frontend Environment Variables
# Copy to .env.local and fill in values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_PREFIX=/api
INTERNAL_API_URL=http://localhost:3001

# App Configuration
NEXT_PUBLIC_APP_NAME=Chenda
NEXT_PUBLIC_APP_DESCRIPTION=Fresh Market - Proximity & Freshness Marketplace

# Map Configuration (Leaflet / OpenStreetMap)
NEXT_PUBLIC_MAP_DEFAULT_LAT=14.5995
NEXT_PUBLIC_MAP_DEFAULT_LNG=120.9842
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13

# Algorithm Defaults
NEXT_PUBLIC_DEFAULT_PROXIMITY_WEIGHT=40
NEXT_PUBLIC_DEFAULT_FRESHNESS_WEIGHT=60
NEXT_PUBLIC_DEFAULT_MAX_RADIUS=10
NEXT_PUBLIC_DEFAULT_MIN_FRESHNESS=20
